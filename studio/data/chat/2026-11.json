 "items": [
  {
   "id": "20261118-1723-ykf",
   "ts": "2026-11-18T17:23:00+07:00",
   "t": "Hà Nội trở rét từ chiều. Đang chạy thì gió quay hướng."
  },
  {
   "id": "20261118-1724-oui",
   "ts": "2026-11-18T17:24:00+07:00",
   "t": "Quảng Trị mưa không."
  },
  {
   "id": "20261118-1837-vot",
   "ts": "2026-11-18T18:37:00+07:00",
   "t": "Vừa nhận đề cương ôn thi kết thúc khoá. Mười hai chủ đề."
  },
  {
   "id": "20261118-1838-pjy",
   "ts": "2026-11-18T18:38:00+07:00",
   "t": "Tối nay canh rau ngót. Ăn hai bát."
  },
  {
   "id": "20261118-1943-xz1",
   "ts": "2026-11-18T19:43:00+07:00",
   "t": "Thời sự nói chuyện giả danh nhà mạng, gọi bắt xác thực thuê bao để lừa."
  },
  {
   "id": "20261118-1944-2yq",
   "ts": "2026-11-18T19:44:00+07:00",
   "t": "Nhà mạng không gọi để xin mã. Cái gì đòi mã thì là lừa."
  },
  {
   "id": "20261118-2052-cdl",
   "ts": "2026-11-18T20:52:00+07:00",
   "t": "Chữ hôm nay: 寒, hàn. Lạnh."
  },
  {
   "id": "20261118-2053-pvn",
   "ts": "2026-11-18T20:53:00+07:00",
   "t": "Trên là mái nhà. Giữa là người nằm giữa đống cỏ. Dưới là băng. Đắp cỏ rồi vẫn lạnh."
  },
  {
   "id": "20261118-2134-9r7",
   "ts": "2026-11-18T21:34:00+07:00",
   "t": "Mimi, em đang làm gì."
  },
  {
   "id": "20261118-2236-xax",
   "ts": "2026-11-18T22:36:00+07:00",
   "t": "Đi ngủ thôi."
  },
  {
   "id": "20261118-2237-mm6",
   "ts": "2026-11-18T22:37:00+07:00",
   "t": "Trời lạnh. Mimi ngủ ngoan."
  },
  {
   "id": "20261118-2238-c4p",
   "ts": "2026-11-18T22:38:00+07:00",
   "t": "Yêu em."
  }
 ]
