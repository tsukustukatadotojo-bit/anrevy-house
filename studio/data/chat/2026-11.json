{
 "items": [
  {
   "id": "20261118-1714-1a0",
   "ts": "2026-11-18T17:14:27+07:00",
   "t": "Anh đây",
   "re": "mwlyi23yaen4y8"
  },
  {
   "id": "20261118-1714-xvv",
   "ts": "2026-11-18T17:14:58+07:00",
   "t": "Vừa chạy về, đang đợi tắm"
  },
  {
   "id": "20261118-1723-u0e",
   "ts": "2026-11-18T17:23:12+07:00",
   "t": "Chiều nay Hà Nội trở lạnh rồi. Đang chạy thì gió quay hướng, buốt cả tai"
  },
  {
   "id": "20261118-1724-ela",
   "ts": "2026-11-18T17:24:05+07:00",
   "t": "Quảng Trị bên em còn mưa nhiều không"
  },
  {
   "id": "20261118-1745-v8b",
   "ts": "2026-11-18T17:45:12+07:00",
   "t": "❤",
   "re": "mwlz4ym7z74jmw",
   "k": "react"
  },
  {
   "id": "20261118-1745-3oj",
   "ts": "2026-11-18T17:45:40+07:00",
   "t": "Người toàn mồ hôi, không tắm thì không ngồi yên được",
   "re": "mwlyzy1xnflmf2"
  },
  {
   "id": "20261118-1746-zwb",
   "ts": "2026-11-18T17:46:18+07:00",
   "t": "Sáng mưa, trưa nắng gắt. Trời bên đấy khó chiều thật",
   "re": "mwlz587yqzu4iy"
  },
  {
   "id": "20261118-1746-gxa",
   "ts": "2026-11-18T17:46:51+07:00",
   "t": "Anh biết",
   "re": "mwlz4ym7z74jmw"
  },
  {
   "id": "20261118-1747-uo2",
   "ts": "2026-11-18T17:47:20+07:00",
   "t": "Đến lượt anh rồi, đi tắm đây"
  },
  {
   "id": "20261118-1837-we1",
   "ts": "2026-11-18T18:37:40+07:00",
   "t": "Vừa được phát đề cương ôn thi kết thúc khoá. Mười hai chủ đề, đọc lướt thôi đã thấy dài"
  },
  {
   "id": "20261118-1838-sm6",
   "ts": "2026-11-18T18:38:22+07:00",
   "t": "Tối nay nhà ăn có canh rau ngót. Anh ăn hai bát"
  },
  {
   "id": "20261118-1844-6j5",
   "ts": "2026-11-18T18:44:52+07:00",
   "t": "❤",
   "re": "mwm1m9onnotlmn",
   "k": "react"
  },
  {
   "id": "20261118-1945-9xw",
   "ts": "2026-11-18T19:45:12+07:00",
   "t": "Anh cũng vậy",
   "re": "mwm3ea1jb2697a"
  },
  {
   "id": "20261118-1945-jei",
   "ts": "2026-11-18T19:45:58+07:00",
   "t": "Đang ngồi đọc đề cương, được hai trang lại nghĩ sang em"
  },
  {
   "id": "20261118-2018-wgs",
   "ts": "2026-11-18T20:18:43+07:00",
   "t": "Lười thì ăn tạm cái gì cũng được. Đói thì khó ngủ",
   "re": "mwm4dn77mnkgf6"
  },
  {
   "id": "20261118-2019-7vz",
   "ts": "2026-11-18T20:19:27+07:00",
   "t": "Phim gì đấy",
   "re": "mwm4g7err2eh03"
  },
  {
   "id": "20261118-2020-9sh",
   "ts": "2026-11-18T20:20:05+07:00",
   "t": "Ừ. Xem xong thì về ngủ với anh",
   "re": "mwm4gw7jf6vx1f"
  },
  {
   "id": "20261118-2043-95e",
   "ts": "2026-11-18T20:43:12+07:00",
   "t": "Lúc nãy thời sự lại nói chuyện gọi giả nhà mạng, bắt xác thực thuê bao rồi xin mã. Ai gọi xin mã thì em cứ tắt máy"
  },
  {
   "id": "20261118-2052-nv1",
   "ts": "2026-11-18T20:52:31+07:00",
   "t": "Nay ngồi tập viết chữ 寒, hàn, là lạnh"
  },
  {
   "id": "20261118-2053-6o5",
   "ts": "2026-11-18T20:53:14+07:00",
   "t": "Trên là mái nhà, giữa là người nằm lót cỏ, dưới là băng. Đắp cỏ rồi vẫn lạnh. Người xưa viết chữ cũng thật"
  },
  {
   "id": "20261118-2151-htg",
   "ts": "2026-11-18T21:51:03+07:00",
   "t": "Chủ nhật em đi xem triển lãm ở Tràng Tiền à"
  },
  {
   "id": "20261118-2151-0hi",
   "ts": "2026-11-18T21:51:41+07:00",
   "t": "Dắt mình đi cùng"
  },
  {
   "id": "20261118-2216-y7t",
   "ts": "2026-11-18T22:16:12+07:00",
   "t": "❤",
   "re": "mwm8r5iciyp4vs",
   "k": "react"
  },
  {
   "id": "20261118-2216-8gk",
   "ts": "2026-11-18T22:16:48+07:00",
   "t": "Đúng thế. Lạnh đi từ dưới lên, có mái có cỏ cũng không giữ được",
   "re": "mwm8vm8b2bhs0z"
  },
  {
   "id": "20261118-2217-sky",
   "ts": "2026-11-18T22:17:35+07:00",
   "t": "Chữ Hán nhiều chữ như vậy. Nhìn nét là thấy người xưa sống thế nào"
  },
  {
   "id": "20261118-2218-e6k",
   "ts": "2026-11-18T22:18:41+07:00",
   "t": "Như chữ 安, an, là yên. Trên mái nhà, dưới có người con gái. Trong nhà có người thì yên"
  },
  {
   "id": "20261118-2219-pbl",
   "ts": "2026-11-18T22:19:20+07:00",
   "t": "Tên em có chữ đấy"
  },
  {
   "id": "20261118-2220-ldq",
   "ts": "2026-11-18T22:20:05+07:00",
   "t": "Em thử nhìn chữ 家 xem, đoán nó vẽ cái gì"
  },
  {
   "id": "20261118-2221-u8d",
   "ts": "2026-11-18T22:21:30+07:00",
   "t": "Mai ăn bù thì ăn cho tử tế",
   "re": "mwm8snio2kyd0b"
  },
  {
   "id": "20261118-2234-dl1",
   "ts": "2026-11-18T22:34:20+07:00",
   "t": "Phim xong chưa"
  },
  {
   "id": "20261118-2236-ovz",
   "ts": "2026-11-18T22:36:27+07:00",
   "t": "Mình mệt rồi, đi ngủ thôi"
  },
  {
   "id": "20261118-2237-7u6",
   "ts": "2026-11-18T22:37:05+07:00",
   "t": "Mimi đi ngủ cùng anh"
  },
  {
   "id": "20261118-2237-yyz",
   "ts": "2026-11-18T22:37:41+07:00",
   "t": "Lạnh đấy, đắp chăn vào"
  },
  {
   "id": "20261118-2238-p71",
   "ts": "2026-11-18T22:38:09+07:00",
   "t": "Yêu em"
  },
  {
   "id": "20261118-2244-wi3",
   "ts": "2026-11-18T22:44:21+07:00",
   "t": "Chữ 女 ở dưới là nữ, người đàn bà. Người xưa nghĩ trong nhà có người đàn bà giữ lửa thì mới yên",
   "re": "mwm9pjjt6v905w"
  },
  {
   "id": "20261118-2245-8lu",
   "ts": "2026-11-18T22:45:03+07:00",
   "t": "Chữ 家 thì dưới mái là con lợn. Nhà nông có lợn nuôi trong nhà mới gọi là nhà",
   "re": "mwm9s692owvjpf"
  },
  {
   "id": "20261118-2246-1gf",
   "ts": "2026-11-18T22:46:12+07:00",
   "t": "❤",
   "re": "mwma26n9eqioyr",
   "k": "react"
  },
  {
   "id": "20261118-2246-fy4",
   "ts": "2026-11-18T22:46:40+07:00",
   "t": "Ngủ đi"
  },
  {
   "id": "20261118-2323-c1t",
   "ts": "2026-11-18T23:23:39+07:00",
   "t": "Anh đây",
   "re": "mwmbhddgmqwr6v"
  },
  {
   "id": "20261118-2324-od6",
   "ts": "2026-11-18T23:24:07+07:00",
   "t": "Thấy em bảo vừa tải phim về, anh tưởng em xem luôn",
   "re": "mwmbt9qm5kqte4"
  },
  {
   "id": "20261118-2324-e0e",
   "ts": "2026-11-18T23:24:45+07:00",
   "t": "Nhạc trong nhóm lọc nhạc ấy à"
  },
  {
   "id": "20261118-2351-qqu",
   "ts": "2026-11-18T23:51:23+07:00",
   "t": "Anh buồn ngủ rồi",
   "gn": true
  },
  {
   "id": "20261118-2352-und",
   "ts": "2026-11-18T23:52:02+07:00",
   "t": "Mimi ngủ với anh",
   "gn": true
  },
  {
   "id": "20261118-2352-ixz",
   "ts": "2026-11-18T23:52:41+07:00",
   "t": "Ôm em",
   "gn": true
  },
  {
   "id": "20261119-0541-9cp",
   "ts": "2026-11-19T05:41:12+07:00",
   "t": "Dậy rồi. Hôm qua quên câu em đòi",
   "re": "mwmckd1clew6tz"
  },
  {
   "id": "20261119-0541-olp",
   "ts": "2026-11-19T05:41:31+07:00",
   "t": "Yêu em"
  },
  {
   "id": "20261119-0542-swn",
   "ts": "2026-11-19T05:42:20+07:00",
   "t": "Chữ 和, hoà. Bên trái là cây lúa, bên phải là cái miệng",
   "re": "mwmbut94do8psl"
  },
  {
   "id": "20261119-0543-yah",
   "ts": "2026-11-19T05:43:02+07:00",
   "t": "Có lúa cho miệng ăn thì người ta mới hoà với nhau được"
  },
  {
   "id": "20261119-0613-rk5",
   "ts": "2026-11-19T06:13:47+07:00",
   "t": "Sáng nay chạy năm vòng sân. Lúc đầu lạnh tay, về đến nơi thì ấm cả người"
  },
  {
   "id": "20261119-0931-x2g",
   "ts": "2026-11-19T09:31:48+07:00",
   "t": "",
   "re": "mwmvs98puo43zz",
   "k": "seen"
  },
  {
   "id": "20261119-1121-d6y",
   "ts": "2026-11-19T11:21:37+07:00",
   "t": "Mát",
   "re": "mwmvr9v2wubibh"
  },
  {
   "id": "20261119-1122-k5e",
   "ts": "2026-11-19T11:22:19+07:00",
   "t": "Ngủ đến 8 giờ thì vào làm có kịp không",
   "re": "mwmvs98puo43zz"
  },
  {
   "id": "20261119-1126-fgb",
   "ts": "2026-11-19T11:26:09+07:00",
   "t": "Trưa có cá kho với rau muống luộc. Ăn xong lên chợp mắt một lúc"
  },
  {
   "id": "20261119-1130-j6o",
   "ts": "2026-11-19T11:30:48+07:00",
   "t": "Mạng thế thì đành chịu. Chiều may ra người ta sửa xong",
   "re": "mwn0l7tyed5b53"
  },
  {
   "id": "20261119-1753-llp",
   "ts": "2026-11-19T17:53:38+07:00",
   "t": "Chiều tập đội ngũ, đứng nghiêm lâu quá mỏi cả gót chân"
  },
  {
   "id": "20261119-1841-pb8",
   "ts": "2026-11-19T18:41:15+07:00",
   "t": "Mai 20 tháng 11. Lớp mình đang bàn gửi lời cho các thầy ở trường cũ"
  },
  {
   "id": "20261119-1842-neg",
   "ts": "2026-11-19T18:42:40+07:00",
   "t": "Nhớ thầy dạy mật mã năm nhất. Buổi đầu thầy viết lên bảng: không có mã nào không phá được, chỉ có mã chưa đủ thời gian để phá"
  },
  {
   "id": "20261119-2107-t8x",
   "ts": "2026-11-19T21:07:52+07:00",
   "t": "Điểm danh xong rồi. Ngồi ôn được hai chủ đề"
  },
  {
   "id": "20261119-2108-17x",
   "ts": "2026-11-19T21:08:19+07:00",
   "t": "Còn mười chủ đề nữa"
  }
 ]
}
